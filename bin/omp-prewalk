#!/usr/bin/env python3
"""Launch Gabriel's reviewed Prewalk without changing ordinary omp."""
import os
from pathlib import Path
import sys

root = Path(__file__).resolve().parents[1]
launcher = root / ".prewalk-source/packages/coding-agent/scripts/omp"
if not launcher.is_file():
    raise SystemExit(f"Run: python3 {root / 'scripts/install-prewalk.py'}")
os.execv(str(launcher), [
    str(launcher),
    "--config", str(root / "prewalk-review.yml"),
    "--extension", str(root / "extensions/luna-priority.ts"),
    "--extension", str(root / "prewalk/workflow"),
    *sys.argv[1:],
])
