diff --git a/packages/coding-agent/src/config/model-resolver.ts b/packages/coding-agent/src/config/model-resolver.ts
index 528a6d0..681d791 100644
--- a/packages/coding-agent/src/config/model-resolver.ts
+++ b/packages/coding-agent/src/config/model-resolver.ts
@@ -2163,6 +2163,76 @@ export function resolveCliModel(options: {
 	};
 }
 
+type AuthenticatedPatternModelRegistry = Pick<
+	ModelRegistry,
+	"getAll" | "getAvailable" | "getDiscoverableProviders" | "refreshDiscoverableProviders" | "hasConfiguredAuth"
+>;
+
+/**
+ * Resolve ordered, already-expanded model patterns while preserving fallback
+ * priority, configured-auth preference, and provider-scoped model discovery.
+ *
+ * When no authenticated match exists, the first unauthenticated match is
+ * returned so callers can report its concrete provider/model auth error.
+ */
+export async function resolveModelPatternsWithAuth(options: {
+	patterns: readonly string[];
+	modelRegistry: AuthenticatedPatternModelRegistry;
+	availableModels?: Model<Api>[];
+	preferences?: ModelMatchPreferences;
+}): Promise<ResolveCliModelResult> {
+	const { patterns, modelRegistry, availableModels, preferences } = options;
+	const resolveCandidate = (pattern: string) =>
+		resolveCliModel({ cliModel: pattern, modelRegistry, availableModels, preferences });
+	let discoverableProviders: Map<string, string> | undefined;
+	const refreshedProviders = new Set<string>();
+	let authenticatedResolution: ResolveCliModelResult | undefined;
+	let firstUnauthenticatedResolution: ResolveCliModelResult | undefined;
+	let lastResolution: ResolveCliModelResult | undefined;
+
+	for (const pattern of patterns) {
+		let candidate = resolveCandidate(pattern);
+		lastResolution = candidate;
+
+		if (candidate.model && modelRegistry.hasConfiguredAuth(candidate.model)) {
+			authenticatedResolution = candidate;
+			break;
+		}
+		if (candidate.model) {
+			firstUnauthenticatedResolution ??= candidate;
+			continue;
+		}
+
+		const requestedProvider = parseModelString(pattern)?.provider.toLowerCase();
+		if (!requestedProvider || refreshedProviders.has(requestedProvider)) continue;
+		discoverableProviders ??= new Map(
+			modelRegistry.getDiscoverableProviders().map(provider => [provider.toLowerCase(), provider]),
+		);
+		const discoverableProvider = discoverableProviders.get(requestedProvider);
+		if (!discoverableProvider) continue;
+
+		refreshedProviders.add(requestedProvider);
+		await modelRegistry.refreshDiscoverableProviders([discoverableProvider], "online-if-uncached");
+
+		candidate = resolveCandidate(pattern);
+		lastResolution = candidate;
+		if (candidate.model && modelRegistry.hasConfiguredAuth(candidate.model)) {
+			authenticatedResolution = candidate;
+			break;
+		}
+		if (candidate.model) {
+			firstUnauthenticatedResolution ??= candidate;
+		}
+	}
+
+	return (
+		authenticatedResolution ??
+		firstUnauthenticatedResolution ??
+		lastResolution ??
+		resolveCliModel({ cliModel: patterns[0], modelRegistry, availableModels, preferences })
+	);
+}
+
 export interface InitialModelResult {
 	model: Model<Api> | undefined;
 	thinkingLevel?: ThinkingLevel;
