diff --git a/packages/coding-agent/src/session/prewalk-review.ts b/packages/coding-agent/src/session/prewalk-review.ts
new file mode 100644
index 0000000..2588d5f
--- /dev/null
+++ b/packages/coding-agent/src/session/prewalk-review.ts
@@ -0,0 +1,318 @@
+import type { AgentMessage, AgentToolResult, AgentTurnEndContext } from "@oh-my-pi/pi-agent-core";
+import { invalidateMessageCache } from "@oh-my-pi/pi-agent-core/compaction";
+import type { ResolvedApprovedPlan } from "../plan-mode/approved-plan";
+import { readPlanFile } from "../plan-mode/plan-files";
+import type { AskToolDetails } from "../tools/ask";
+import { ToolError } from "../tools/tool-errors";
+import type { Prewalk } from "./agent-session-types";
+import type { PrewalkCoordinatorHost } from "./prewalk";
+
+const STATE_TYPE = "prewalk-review-state";
+export const PREWALK_REVIEW_CONTEXT_TYPE = "prewalk-review-context";
+
+export type PrewalkReviewState = {
+	prewalk: Prewalk;
+	phase: "draft" | "review";
+	/** Fresh same-model flows plan and review in one phase. Absent on older persisted states. */
+	directPlanning?: boolean;
+	planFilePath: string;
+	planTitle: string;
+	/** null records a genuine answer received before any plan existed. */
+	planAtAnswer?: string | null;
+	previousTools: { enabled: string[]; mounted: string[] };
+};
+
+/** The human clarification gate is independent of the background advisor runtime. */
+export class PrewalkReview {
+	readonly #host: PrewalkCoordinatorHost;
+	readonly #resolvePlan: (title: string) => Promise<ResolvedApprovedPlan>;
+	readonly #implement: (
+		plan: ResolvedApprovedPlan,
+		previousTools: PrewalkReviewState["previousTools"],
+	) => Promise<void>;
+	readonly #state: PrewalkReviewState;
+	#started = false;
+	#pending: ResolvedApprovedPlan | undefined;
+
+	constructor(
+		host: PrewalkCoordinatorHost,
+		prewalk: Prewalk,
+		resolvePlan: (title: string) => Promise<ResolvedApprovedPlan>,
+		implement: (plan: ResolvedApprovedPlan, previousTools: PrewalkReviewState["previousTools"]) => Promise<void>,
+		restored?: PrewalkReviewState,
+	) {
+		this.#host = host;
+		this.#resolvePlan = resolvePlan;
+		this.#implement = implement;
+		if (restored) {
+			this.#state = { ...restored };
+			return;
+		}
+		const reviewer = prewalk.reviewer!;
+		const planner = host.model();
+		const directPlanning = planner?.id === reviewer.model.id && planner.provider === reviewer.model.provider;
+		this.#state = {
+			prewalk,
+			phase: directPlanning ? "review" : "draft",
+			directPlanning,
+			planFilePath: "local://prewalk-plan.md",
+			planTitle: "prewalk",
+			previousTools: {
+				enabled: host.getEnabledToolNames(),
+				mounted: host.getMountedXdevToolNames(),
+			},
+		};
+	}
+
+	static restore(host: PrewalkCoordinatorHost): PrewalkReviewState | undefined {
+		const entry = host.sessionManager
+			.getBranch()
+			.findLast(item => item.type === "custom" && item.customType === STATE_TYPE);
+		if (!entry || entry.type !== "custom" || entry.data == null) return undefined;
+		const state = entry.data as PrewalkReviewState;
+		if (
+			!state.prewalk?.reviewer?.model ||
+			!state.prewalk.target ||
+			!state.previousTools ||
+			(state.phase !== "draft" && state.phase !== "review") ||
+			(state.directPlanning !== undefined && typeof state.directPlanning !== "boolean") ||
+			(state.planAtAnswer !== undefined && state.planAtAnswer !== null && typeof state.planAtAnswer !== "string") ||
+			typeof state.planFilePath !== "string"
+		) {
+			throw new Error("Cannot restore pending Prewalk review. Review the session before continuing.");
+		}
+		return state;
+	}
+
+	#persist(): void {
+		this.#host.sessionManager.appendCustomEntry(STATE_TYPE, { ...this.#state });
+	}
+
+	restart(): void {
+		this.#state.phase = this.#state.directPlanning ? "review" : "draft";
+		this.#state.planAtAnswer = undefined;
+		this.#pending = undefined;
+		this.#started = false;
+		this.#persist();
+	}
+
+	interrupt(): void {
+		this.#pending = undefined;
+		this.#state.planAtAnswer = undefined;
+		this.#persist();
+	}
+
+	#instruct(liveMessages?: AgentMessage[]): void {
+		this.#clearInstructions(liveMessages);
+		const activeNotice =
+			"Reviewed Prewalk is already active for this turn. Treat the current user message as its planning request or continuation. Never ask the user to run /prewalk or /prewalk restart. ";
+		const content =
+			this.#state.phase === "draft"
+				? `Reviewed Prewalk: DRAFT phase. Inspect the user's request and relevant code, then write a complete implementation plan to ${this.#state.planFilePath}. Include scope, assumptions, acceptance criteria, risks and unresolved intent. Do not implement. Another model will challenge the plan and ask the user before implementation. Submit the draft by writing "prewalk" to xd://propose. Draft submission is NOT approval.`
+				: this.#state.directPlanning
+					? `Reviewed Prewalk: PLANNING phase. You are the sole planner and plan reviewer. Inspect the original user request and relevant repository evidence, challenge unsupported assumptions, and use ask to obtain the user's explicit clarification: ask concrete intent/tradeoff questions that evidence cannot answer; if none remain, ask the user to confirm your concrete interpretation of scope. Never invent an answer or treat cancellation, timeout, or a chat redirect as consent. After the user answers, write or revise the complete implementation plan at ${this.#state.planFilePath} to incorporate those answers (record confirmed scope even if unchanged), then write "prewalk" to xd://propose. No separate draft submission is required. No implementation before that handoff. Do not delegate planning or the user's answers to another model.`
+					: `Reviewed Prewalk: REVIEW phase. You are the plan reviewer, not the background advisor. Read the original user request, the full plan at ${this.#state.planFilePath}, and relevant repository evidence. Challenge unsupported assumptions and check whether this plan actually matches the desired ask. Use ask to obtain the user's explicit clarification: ask concrete intent/tradeoff questions that evidence cannot answer; if none remain, ask the user to confirm your concrete interpretation of scope. Never invent an answer or treat cancellation, timeout, or a chat redirect as consent. After the user answers, revise the plan file to incorporate those answers (record confirmed scope even if unchanged), then write "prewalk" to xd://propose. No implementation before that handoff. Do not delegate this review or the user's answers to another model.`;
+		// A resumed review uses the recorded answer rather than asking for it twice.
+		const resumeNote =
+			this.#state.planAtAnswer === undefined
+				? ""
+				: " The user's answer is already recorded in this session. Incorporate it into the same plan before proposing; ask again only if it exposed a new material ambiguity.";
+		this.#host.agent.steer({
+			role: "custom",
+			customType: PREWALK_REVIEW_CONTEXT_TYPE,
+			content: activeNotice + content + resumeNote,
+			display: false,
+			attribution: "agent",
+			timestamp: Date.now(),
+		});
+	}
+
+	#clearInstructions(liveMessages?: AgentMessage[]): void {
+		if (liveMessages) {
+			for (let index = liveMessages.length - 1; index >= 0; index--) {
+				const message = liveMessages[index];
+				if (message.role !== "custom" || message.customType !== PREWALK_REVIEW_CONTEXT_TYPE) continue;
+				invalidateMessageCache(liveMessages[index]);
+				liveMessages.splice(index, 1);
+			}
+		}
+		const messages = this.#host.agent.state.messages;
+		this.#host.agent.replaceMessages(
+			messages.filter(message => message.role !== "custom" || message.customType !== PREWALK_REVIEW_CONTEXT_TYPE),
+		);
+	}
+
+	async start(): Promise<void> {
+		if (this.#started) return;
+		if (!this.#host.hasBuiltInTool("ask") || !this.#host.hasBuiltInTool("write")) {
+			throw new Error(
+				"Reviewed Prewalk requires interactive ask and write tools; implementation remains blocked. Use an interactive session.",
+			);
+		}
+		const previousState = this.#host.getPlanModeState();
+		this.#host.setPlanModeState({
+			enabled: true,
+			planFilePath: this.#state.planFilePath,
+			workflow: "iterative",
+			strict: true,
+		});
+		try {
+			const tools = this.#host.getEnabledToolNames().filter(name => name !== "ask");
+			await this.#host.setActiveToolPresentation(
+				[...new Set([...tools, "write", ...(this.#state.phase === "review" ? ["ask"] : [])])],
+				[],
+			);
+			if (this.#state.phase === "review") {
+				const reviewer = this.#state.prewalk.reviewer!;
+				if (
+					!this.#state.directPlanning ||
+					!this.#reviewerIsActive() ||
+					(reviewer.thinkingLevel !== undefined && this.#host.configuredThinkingLevel() !== reviewer.thinkingLevel)
+				) {
+					await this.#host.setModelTemporary(reviewer.model, reviewer.thinkingLevel, { ephemeral: true });
+				}
+			}
+		} catch (error) {
+			this.#host.setPlanModeState(previousState);
+			await this.#host.setActiveToolPresentation(
+				this.#state.previousTools.enabled,
+				this.#state.previousTools.mounted,
+			);
+			throw error;
+		}
+		this.#host.setPlanProposalHandler(title => this.#propose(title));
+		this.#started = true;
+		this.#persist();
+		this.#instruct();
+	}
+
+	#reviewerIsActive(): boolean {
+		const active = this.#host.model();
+		const reviewer = this.#state.prewalk.reviewer!;
+		return active?.id === reviewer.model.id && active.provider === reviewer.model.provider;
+	}
+
+	async #readPlanSnapshot(): Promise<string | null> {
+		return readPlanFile(this.#state.planFilePath, {
+			localProtocolOptions: this.#host.localProtocolOptions(),
+			cwd: this.#host.sessionManager.getCwd(),
+		});
+	}
+
+	async #readReviewedPlan(): Promise<ResolvedApprovedPlan> {
+		const planContent = await this.#readPlanSnapshot();
+		if (planContent === null)
+			throw new ToolError(
+				`Reviewed plan not found at ${this.#state.planFilePath}. Restore that plan before continuing.`,
+			);
+		return { planFilePath: this.#state.planFilePath, planContent, title: this.#state.planTitle };
+	}
+
+	async #propose(title: string): Promise<AgentToolResult<unknown>> {
+		if (!this.#host.getPlanModeState()?.strict)
+			throw new ToolError("Prewalk plan review must remain read-only until handoff.");
+		const plan = this.#state.phase === "draft" ? await this.#resolvePlan(title) : await this.#readReviewedPlan();
+		if (!plan.planContent.trim()) throw new ToolError("Write a non-empty plan before submitting it.");
+		if (this.#state.phase === "review") {
+			if (!this.#reviewerIsActive()) {
+				throw new ToolError("Only the configured Prewalk reviewer may submit the clarified plan.");
+			}
+			if (this.#state.planAtAnswer === undefined) {
+				throw new ToolError(
+					"Ask the user to clarify or confirm the plan and wait for a genuine answer before handoff.",
+				);
+			}
+			if (this.#state.planAtAnswer !== null && plan.planContent === this.#state.planAtAnswer) {
+				throw new ToolError(
+					"Revise the plan after the user's answer, recording the clarified or confirmed decisions, before handoff.",
+				);
+			}
+		}
+		// Do not unlock tools inside a tool batch: subsequent calls from the same
+		// assistant response still belong to the planner/reviewer, not the implementer.
+		this.#pending = plan;
+		return {
+			content: [
+				{
+					type: "text",
+					text:
+						this.#state.phase === "draft"
+							? "Draft received. The next turn belongs to the plan reviewer; implementation remains blocked."
+							: "Clarified plan received. Handoff occurs after this tool batch; implementation remains blocked until then.",
+				},
+			],
+			details: { prewalkPhase: this.#state.phase },
+		};
+	}
+
+	async advance(liveMessages: AgentMessage[], context: AgentTurnEndContext): Promise<void> {
+		if (context.message.role !== "assistant") return;
+		await this.#host.waitForSessionMessagePersistence(context.message);
+		for (const result of context.toolResults) await this.#host.waitForSessionMessagePersistence(result);
+		if (this.#state.phase === "review") {
+			for (const result of context.toolResults) {
+				if (result.toolName !== "ask") continue;
+				const details = result.details as AskToolDetails | undefined;
+				const answers = details?.results ?? (details?.question ? [details] : []);
+				const reviewer = this.#state.prewalk.reviewer!;
+				const answered =
+					context.message.model === reviewer.model.id &&
+					context.message.provider === reviewer.model.provider &&
+					!result.isError &&
+					!details?.chatRedirect &&
+					answers.length > 0 &&
+					answers.every(
+						answer =>
+							!answer.timedOut &&
+							(answer.multi === true ||
+								(answer.selectedOptions?.length ?? 0) > 0 ||
+								(answer.customInput?.trim().length ?? 0) > 0),
+					);
+				// Every new question invalidates previous clearance, including a cancelled
+				// follow-up. Snapshot at the completed tool-batch boundary: a plan written
+				// later in the same batch must still be revised on a later turn, while null
+				// records that the answer preceded the first plan without granting approval.
+				this.#pending = undefined;
+				this.#state.planAtAnswer = answered ? await this.#readPlanSnapshot() : undefined;
+				this.#persist();
+			}
+		}
+		const plan = this.#pending;
+		if (!plan) return;
+		if (
+			context.message.stopReason === "aborted" ||
+			context.message.stopReason === "error" ||
+			context.toolResults.some(result => result.isError)
+		) {
+			this.#pending = undefined;
+			return;
+		}
+		if (this.#state.phase === "draft") {
+			const reviewer = this.#state.prewalk.reviewer!;
+			await this.#host.setModelTemporary(reviewer.model, reviewer.thinkingLevel, { ephemeral: true });
+			await this.#host.setActiveToolPresentation([...new Set([...this.#host.getEnabledToolNames(), "ask"])], []);
+			this.#pending = undefined;
+			this.#state.phase = "review";
+			this.#state.planFilePath = plan.planFilePath;
+			this.#state.planTitle = plan.title;
+			this.#host.setPlanModeState({
+				enabled: true,
+				planFilePath: plan.planFilePath,
+				workflow: "iterative",
+				strict: true,
+			});
+			this.#persist();
+			this.#host.emitNotice(
+				"info",
+				`Prewalk review: ${reviewer.model.provider}/${reviewer.model.id} will challenge the draft and ask you before implementation.`,
+				"prewalk",
+			);
+			this.#instruct(liveMessages);
+			return;
+		}
+		await this.#implement(plan, this.#state.previousTools);
+		this.#clearInstructions(liveMessages);
+		this.#pending = undefined;
+		this.#host.sessionManager.appendCustomEntry(STATE_TYPE, null);
+	}
+}
